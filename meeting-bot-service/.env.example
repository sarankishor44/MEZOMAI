APP_ENV=production
PORT=8010

# Comma-separated domains allowed to call this bot service.
ALLOWED_ORIGINS=https://mezomai.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Optional but recommended. If set, callers must send Authorization: Bearer <key>.
MEETING_BOT_API_KEY=replace-with-long-random-secret

# true for production. Set false only when debugging with a visible browser.
BOT_HEADLESS=true

# Browser session limit per meeting.
BOT_MAX_SESSION_SECONDS=5400
BOT_ARTIFACT_DIR=/tmp/mezomai-bots
