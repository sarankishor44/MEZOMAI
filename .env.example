APP_ENV=production
APP_DEBUG=false

# Required: change before deploying.
JWT_SECRET=replace-with-a-long-random-secret

# Browser/API origins allowed by FastAPI CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend service targets.
VITE_PHP_API=http://localhost:8000/api
VITE_PYTHON_API=http://localhost:8001/ai
VITE_WS_URL=ws://localhost:8001/ws

# Database defaults used by docker-compose.
DB_DATABASE=aria_platform
DB_USERNAME=aria_user
DB_PASSWORD=aria_secret
MYSQL_ROOT_PASSWORD=root_secret

# Optional provider keys for server-side AI features.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
DAILY_API_KEY=
