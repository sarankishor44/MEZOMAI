APP_NAME=MEZOMAI
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-php-api-host.com

# Frontend domains allowed by your hosting CORS/rewrite layer.
FRONTEND_URL=https://mezomai.vercel.app
ALLOWED_ORIGINS=https://mezomai.vercel.app,http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET=replace-with-a-long-random-secret

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=aria_platform
DB_USERNAME=aria_user
DB_PASSWORD=aria_secret

REDIS_HOST=redis
REDIS_PORT=6379

# Your separated Python/FastAPI backend URL. Include /code endpoints base only, no trailing slash.
PYTHON_BACKEND_URL=https://your-python-api-host.vercel.app

RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM="MEZOMAI <onboarding@resend.dev>"
