APP_ENV=production

# Comma-separated frontend URLs allowed to call this API.
ALLOWED_ORIGINS=https://mezomai.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Optional: only when MEZOMAI should join Google Meet/Zoom/Teams links as a real bot participant.
MEETING_BOT_PROVIDER=meetingbaas
MEETINGBAAS_API_KEY=replace-with-meetingbaas-api-key
