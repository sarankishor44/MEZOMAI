APP_ENV=production

# Comma-separated frontend URLs allowed to call this API.
ALLOWED_ORIGINS=https://mezomai.vercel.app,https://mezomai-oao1.vercel.app,https://mezomaiadmin.vercel.app,https://mezomai-1iyn.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Note: Any *.vercel.app subdomain is also automatically allowed by the CORS middleware

# Optional: MEZOMAI self-hosted browser bot service.
MEETING_BOT_API_URL=https://your-meeting-bot-service.com
MEETING_BOT_API_KEY=replace-with-long-random-secret

# Backend fallback model keys. Users can also bring their own keys from Settings.
DEFAULT_AI_PROVIDER=gemma
DEFAULT_AI_MODEL=gemma-3-27b-it
DEFAULT_AI_DAILY_REQUESTS=25
DEFAULT_AI_WINDOW_HOURS=24
DEFAULT_AI_BUDGET_MINUTES=30
DEFAULT_GEMMA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
